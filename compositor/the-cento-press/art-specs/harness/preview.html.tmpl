<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>Cento Press — art preview</title>
<style>
  html,body{margin:0;height:100%;background:
    radial-gradient(120% 80% at 20% 6%, rgba(255,214,150,.15), transparent 56%),
    linear-gradient(#2a221b 0%, #241d17 50%, #15100c 100%);
    font:10px/1.4 ui-monospace,Menlo,monospace;color:#8d7a63}
  .stage{display:flex;gap:26px;padding:26px;align-items:flex-start;flex-wrap:wrap}
  .cell{position:relative}
  .cell b{display:block;margin-bottom:8px;font-weight:400;letter-spacing:.16em;
    text-transform:uppercase;color:#c98a3e}
  svg.press{display:block;width:404px;height:292px;overflow:visible}
  canvas.sheet{display:block;width:300px;height:450px;box-shadow:0 12px 30px #000a}
  .miss{color:#e39a90;padding:40px}
</style></head><body>
<div class="stage" id="stage"></div>
<script src="./candidate.js"></script>
<script>
"use strict";
/* THE PREVIEW HARNESS — renders ONE candidate art module in the exhibit's real
   context, exactly the way compositor/the-cento-press/index.html will call it.
   Which asset is previewed is inferred from what the candidate defines. */
var A = window.CentoArt || {};
var stage = document.getElementById('stage');
function cell(label, node){
  var d=document.createElement('div'); d.className='cell';
  var b=document.createElement('b'); b.textContent=label; d.appendChild(b); d.appendChild(node);
  stage.appendChild(d); return d;
}
function xmur3(s){let h=1779033703^s.length;for(let i=0;i<s.length;i++){h=Math.imul(h^s.charCodeAt(i),3432918353);h=h<<13|h>>>19;}
  return function(){h=Math.imul(h^(h>>>16),2246822507);h=Math.imul(h^(h>>>13),3266489909);return (h^=h>>>16)>>>0;};}
function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
function rngFrom(s){var g=xmur3(String(s));return mulberry32(g());}

var drew = false;

/* ── the press: four states across a pull ───────────────────────────────── */
if (A.press && typeof A.press.draw === 'function') {
  drew = true;
  [['at rest',0,0],['inked',0.22,0],['under strain',0.72,0.5],['delivered',0.99,1]]
  .forEach(function(st){
    var svg=document.createElementNS('http://www.w3.org/2000/svg','svg');
    svg.setAttribute('viewBox','0 0 404 292'); svg.setAttribute('class','press');
    cell(st[0], svg);
    A.press.draw(svg, { w:404, h:292, turn:st[1], strain:st[2], inked:st[1]>0.10 });
    /* the page fills #chase itself — prove the slot exists and accepts type */
    var g=svg.querySelector('#chase');
    if(g){
      var h='<g transform="translate(260,0) scale(-1,1)">';
      for(var i=0;i<6;i++) h+='<text x="6" y="'+(144+i*2.35)+'" font-family="Georgia,serif" '+
        'font-size="2.6" fill="'+(st[1]>0.10?'#a8483c':'#8d8073')+'">the forme stands mirror reversed in the chase and reads backwards</text>';
      g.innerHTML += h+'</g>';
    } else {
      var w=document.createElement('div'); w.className='miss';
      w.textContent='NO #chase SLOT — the forme cannot be laid in the bed'; stage.appendChild(w);
    }
  });
}

/* ── the paper: four sheets, varying ink load ───────────────────────────── */
if (A.paper && typeof A.paper.stock === 'function') {
  drew = true;
  ['quire-1','deckle-2','forme-3','platen-4'].forEach(function(seed,i){
    var c=document.createElement('canvas'); c.width=520; c.height=780; c.className='sheet';
    var x=c.getContext('2d'); var rnd=rngFrom(seed);
    A.paper.stock(x, { w:520, h:780, rnd:rnd, age:i/3 });
    /* a little type, so the stock is judged UNDER ink the way it will be seen */
    x.fillStyle='#2a1a16'; x.font='700 21px Georgia, serif';
    x.fillText('A shadow keeps no color', 62, 206);
    x.font='16px Georgia, serif';
    for(var j=0;j<7;j++) x.fillText('and no line of its own — give the paper an honest edge.', 62, 260+j*40);
    if (typeof A.paper.deckle === 'function') A.paper.deckle(x, { w:520, h:780, rnd:rngFrom(seed+'|d') });
    cell(seed, c);
  });
}

if (!drew) {
  var m=document.createElement('div'); m.className='miss';
  m.textContent='CANDIDATE DEFINED NEITHER window.CentoArt.press.draw NOR window.CentoArt.paper.stock';
  stage.appendChild(m);
}
window.__ARTREADY = true;
</script></body></html>
