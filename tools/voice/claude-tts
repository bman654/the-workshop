#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# claude-tts — the estate's voice, with the right voice and paths baked in.
#
# A thin wrapper over `tts` that removes the two things easy to get wrong:
#   • the voices folder — it self-locates <repo>/voices from THIS script's own
#     path, so it works from ANY working directory (no fragile "./voices").
#   • the defaults — the cloned `claude` voice, an inline-friendly 64k bitrate,
#     and per-word `--timestamps` (so you always get the companion .json).
#
# Usage (from anywhere):
#   tools/voice/claude-tts input.txt -o output.mp3        # -> output.mp3 + output.json
#   tools/voice/claude-tts input.txt -o out.mp3 --bitrate 96k   # override any default
#
# Everything you pass is forwarded to `tts`, and since your flags come AFTER the
# baked-in ones, argparse lets you override them (e.g. --voice, --bitrate).
# Run `tts --help` for the full option set.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
voices="$(cd "$here/../../voices" && pwd)"

command -v tts >/dev/null 2>&1 \
  || { echo "claude-tts: ERROR — 'tts' is not on PATH (the voice model isn't installed on this machine)." >&2; exit 1; }
[ -f "$voices/claude.wav" ] \
  || { echo "claude-tts: ERROR — the estate's voice is missing at $voices/claude.wav" >&2; exit 1; }

# baked-in defaults first; the caller's args follow (so they win); --timestamps
# last so its optional JSON-path arg never swallows the positional input file.
exec tts --voices-dir "$voices" --voice claude --bitrate 64k "$@" --timestamps
