.DS_Store
node_modules/
*.log

# editor swap/backup files (never commit a live vim session's scratch)
*.swp
*.swo
*~

# transient claude state
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
*.lock

# Creator's Ledger inbox — transient per-mark drops, collated into ledger.jsonl
ledger/inbox/*
!ledger/inbox/.gitkeep

# stray root-level screenshot artifacts (a scratch slideshow shot-set left untracked at root;
# unreferenced, multi-MB) — keep the seal commit from ever capturing them (#411 housekeeping)
/shot-s*.png
